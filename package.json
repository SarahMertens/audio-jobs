{
  "name": "audio-jobs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @audio-jobs/api dev",
    "dev:worker": "pnpm --filter @audio-jobs/worker dev",
    "dev:web": "pnpm --filter @audio-jobs/web dev",
    "db:migrate": "pnpm --filter @audio-jobs/api migrate",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.test.json",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}